{
    "plugins": {
        "audio": {
            "version": "1.0.0",
            "description": "Captura y reproducción de audio",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": ["audio_access"]
        },
        "motion_detector": {
            "version": "1.0.0",
            "description": "Detección de movimiento",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": ["camera_access"]
        },
        "face_recognizer": {
            "version": "1.0.0",
            "description": "Reconocimiento facial",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": ["camera_access"]
        },
        "document_scanner": {
            "version": "1.0.0",
            "description": "Escaneo de documentos",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": ["camera_access"]
        },
        "image_enhancer": {
            "version": "1.0.0",
            "description": "Mejora interactiva de imágenes",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": []
        },
        "notifications": {
            "version": "1.0.0",
            "description": "Notificaciones (Windows, Telegram)",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": ["network", "notifications", "telegram"]
        },
        "debug_console": {
            "version": "1.0.0",
            "description": "Consola de debug integrada",
            "author": "ProCamera",
            "enabled_by_default": false,
            "auto_load": false,
            "requires_debug": true,
            "capabilities": ["ui_modify"]
        },
        "camera_controls": {
            "version": "1.0.0",
            "description": "Controla hardware de cámara IP (flash)",
            "author": "ProCamera",
            "enabled_by_default": true,
            "auto_load": true,
            "capabilities": ["camera_control"]
        }
    }
}